     // (?s3=...,swim: the collar sits on the water surface under her, not on her bob, so she bobs in it)
     if (SWIM_ON) S.base += (W.surface(L, S.lagX, z, time.value) - S.base) * e(0.05);
     else S.base += (ride + dip - S.base) * e(0.05);
