+// ?s3=match on screens taller than 1:2 (phones): the same width as the approved 1:2 picture, framed from its top edge, so
+// the rim, tunnel, character and objects sit under the HUD where the approved Screen 4 has them; the extra height falls
+// below, in the water at the bottom. A vertical lens shift (view offset) only: the direction of view and the horizontal
+// coverage are unchanged, and so are the hero shaders (they work in angles round the camera). k: 0 before the tunnel
+// (Screen 3 keeps its framing), 1 inside it. At 1:2 or wider nothing changes (the 538 x 1076 captures included).
+function matchPhoneFrame(fovV, k) {
+  const aspect = camera.aspect;
+  if (aspect >= 0.5 || k <= 0) { if (camera.view && camera.view.enabled) camera.clearViewOffset(); return; }
+  const t0 = Math.tan(THREE.MathUtils.degToRad(fovV) / 2), ty = (t0 * 0.5) / aspect;   // half-heights: approved 1:2, this screen
+  const H = 1000, Wd = H * aspect;
+  camera.setViewOffset(Wd, H, 0, (k * (ty - t0) / (2 * ty)) * H, Wd, H);
+}
