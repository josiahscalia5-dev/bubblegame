+    im=load(p); h,s,v=hsv(im); yy,xx=np.mgrid[0:H0,0:W0]
+    warm=(((h>=10)&(h<55))|(h>=345))&(s>0.25)&(v>0.55)&(yy>0.08*H0)&(yy<0.42*H0)
+    # exclude coins/pink brushes: brushes are pink h>=290 so not included; coins below .42 excluded
