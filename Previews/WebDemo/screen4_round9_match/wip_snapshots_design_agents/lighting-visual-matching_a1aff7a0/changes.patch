+      vanishingPoint_trackDirection: vp.slice(0, 2).map((v) => +v.toFixed(3)), uMatchVP_screen: [+vpx.toFixed(3), +vpy.toFixed(3)], axisOnScreen: axis, wallVertices: n, rings: out };
