+  return structPrivately(0x57a3, () => {
+    // a superellipse loop in (r, z), as round6's roundedSection
+    const rc = (R.inner + R.outer) / 2, zc = (R.front + R.back) / 2, hr = (R.outer - R.inner) / 2, hz = (R.back - R.front) / 2, e = 2 / Math.max(0.1, R.round), prof = [];
