+// ================================================================ 4. the tunnel (opt-in ,tunnel2)
+// at the end of matchWall's screen colour c (tunnel_r9_match.js; rw: the screen radius round the centre, in widths)
+export function structTunnelGLSL() {
+  const T = STRUCT.tunnel, C = T.core;
