+import sys
+from PIL import Image, ImageDraw
+p=sys.argv[1]; x0,y0,x1,y1=map(float,sys.argv[2:6]); out=sys.argv[6]; step=float(sys.argv[7]) if len(sys.argv)>7 else 0.01
