# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# IDE / solution files
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Builds
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
sysinfo.txt

# OS
.DS_Store
Thumbs.db

# Generated preview renders live here until reviewed (keep the folder, not every capture)
/Previews/Captures/*
!/Previews/Captures/.gitkeep

# Local secrets and tool sign-ins (never commit keys)
.env
.env.*
!.env.example
.tripo/
.playwright-mcp/

# Claude Code agent worktrees (separate checkouts; their work is merged by commit, never added as folders)
.claude/worktrees/

# Android preview build signing key (Tools/android_apk/build_apk.sh keeps it outside the repo anyway)
*.keystore
__pycache__/

# Parallax (parallax-threejs) local debug state: checkpoints, diffs, sweeps, reports and its own Chrome profile.
# Kept out of Git (as in the plugin's own repository); copy outputs worth keeping into an evidence folder under Previews/.
.parallax/
# playwright-mcp (parallax-threejs) page snapshots and console logs, written to the working directory: local only
.playwright-mcp/

# (session 3849f5c8) raw recording frames: only the encoded mp4 is kept in Git
Previews/WebDemo/six_scenes/*/recording_frames/*.jpg
