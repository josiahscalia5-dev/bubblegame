<?xml version="1.0" encoding="utf-8"?>
<!-- Bubble Wash Kingdom preview app: one full-screen WebView that plays the web game (WebDemo/) packed inside the APK. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bubblewash.kingdom"
    android:versionCode="1"
    android:versionName="0.8.2-splash">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />
    <!-- only for the Fredoka web font (fonts.googleapis.com); the game itself is inside the APK and plays offline -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Bubble Wash Kingdom"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
