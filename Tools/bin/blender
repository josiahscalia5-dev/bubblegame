#!/usr/bin/env bash
# `blender` for machines that have Blender's Python API as the bpy module (pip package bpy 5.2.3) but no Blender binary.
# Supports the headless form the project's scripts use:
#
#   blender -b [--factory-startup] --python script.py [-- args...]
#   blender --version
#
# The script runs in the bpy Python ($BW_BPY, set by Tools/bw_tools_env.sh) with sys.argv = [script.py, '--', args...],
# so scripts that read their arguments after '--' work unchanged. The bpy module starts from factory settings.
set -euo pipefail
BPY="${BW_BPY:-$HOME/.bubblewash-tools/blender/bin/python}"
if [ ! -x "$BPY" ]; then echo "blender: no Blender binary and no bpy Python at $BPY (source Tools/bw_tools_env.sh)" >&2; exit 127; fi
script=""; rest=()
while [ $# -gt 0 ]; do
  case "$1" in
    -b|--background|--factory-startup|-noaudio|--noaudio) shift ;;
    --version|-v) exec "$BPY" -c "import bpy; print('Blender', bpy.app.version_string, '(bpy module)')" ;;
    -P|--python) script="$2"; shift 2 ;;
    --) rest=("$@"); break ;;
    *) echo "blender (bpy shim): unsupported option $1" >&2; exit 2 ;;
  esac
done
[ -n "$script" ] || { echo "blender (bpy shim): needs --python <script.py>" >&2; exit 2; }
exec "$BPY" "$script" "${rest[@]}"
